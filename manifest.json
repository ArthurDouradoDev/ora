{
  "manifest_version": 3,
  "name": "Ora - Nova Aba",
  "version": "1.3.0",
  "description": "Um espaço de oração e foco para substituir a nova aba.",
  "chrome_url_overrides": {
    "newtab": "ora.html"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icon.png"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": ["favicon", "storage", "declarativeNetRequest", "alarms", "tabs", "webNavigation", "notifications", "idle"],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [{
    "matches": ["https://arthurdouradodev.github.io/ora-player-relay/*"],
    "exclude_matches": ["https://arthurdouradodev.github.io/ora-player-relay/v2/*"],
    "js": ["scripts/sound-relay.js"],
    "run_at": "document_end",
    "all_frames": true
  }],
  "web_accessible_resources": [{
    "resources": ["blocked.html"],
    "matches": ["https://*/*", "http://*/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.youtube.com https://open.spotify.com https://*.github.io; connect-src 'self' https:; img-src 'self' https: data:; default-src 'self'; upgrade-insecure-requests;"
  }
}
